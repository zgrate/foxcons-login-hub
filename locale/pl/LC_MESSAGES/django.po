#: bridge_oidc/templates/bridge_oidc/authorize.html:4
#: bridge_oidc/templates/bridge_oidc/authorize.html:78
msgid "Authorize"
msgstr "Autoryzuj"

#: bridge_oidc/templates/bridge_oidc/authorize.html:11
msgid "Authorization Request"
msgstr "Żądanie autoryzacji"

#: bridge_oidc/templates/bridge_oidc/authorize.html:13
msgid ""
"A connected application is requesting access to your Foxcons identity claims."
msgstr "Połączona aplikacja prosi o dostęp do Twoich danych."

#: bridge_oidc/templates/bridge_oidc/authorize.html:21
msgid "Signed in as"
msgstr "Zalogowano jako"

#: bridge_oidc/templates/bridge_oidc/authorize.html:36
msgid "Requested permissions"
msgstr "Wymagane uprawnienia"

#: bridge_oidc/templates/bridge_oidc/authorize.html:52
msgid "User identification"
msgstr "Identyfikacja użytkownika"

#: bridge_oidc/templates/bridge_oidc/authorize.html:58
msgid "Email address"
msgstr "Adres e-mail"

#: bridge_oidc/templates/bridge_oidc/authorize.html:64
msgid "Profile information"
msgstr "Informacje o profilu"

#: bridge_oidc/templates/bridge_oidc/authorize.html:81
msgid "Deny"
msgstr "Odrzuć"

#: bridge_oidc/templates/bridge_oidc/authorize.html:86
#: bridge_oidc/templates/bridge_oidc/continue.html:105
msgid "Use a different account"
msgstr "Użyj innego konta"

#: bridge_oidc/templates/bridge_oidc/base.html:8
#: bridge_oidc/templates/bridge_oidc/login.html:12
msgid "Foxcons Auth"
msgstr "Foxcons Auth"

#: bridge_oidc/templates/bridge_oidc/continue.html:4
#: bridge_oidc/templates/bridge_oidc/continue.html:11
msgid "Continue Session"
msgstr "Kontynuuj sesję"

#: bridge_oidc/templates/bridge_oidc/continue.html:13
msgid ""
"Reuse your existing Foxcons session or switch to a different event/account."
msgstr "Użyj istniejącej sesji lub przełącz na inne wydarzenie/konto."

#: bridge_oidc/templates/bridge_oidc/continue.html:60
msgid "Event"
msgstr "Wydarzenie"

#: bridge_oidc/templates/bridge_oidc/continue.html:88
#, python-format
msgid "Continue as %(display_name)s"
msgstr "Kontynuuj jako %(display_name)s"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:4
msgid "Email Sign In"
msgstr "Logowanie e-mailem"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:11
msgid "Sign In With Email"
msgstr "Zaloguj się e-mailem"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:13
msgid ""
"Can't access your event anymore? We'll email you a one-time code to continue."
msgstr "Nie masz już dostępu do wydarzenia? Wyślemy Ci e-mailem jednorazowy kod, aby kontynuować."

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:39
#: bridge_oidc/templates/bridge_oidc/login.html:115
msgid "Email"
msgstr "E-mail"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:51
#: bridge_oidc/templates/bridge_oidc/login.html:127
msgid "you@example.com"
msgstr "sample@example.com"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:63
msgid "Send Me a Code"
msgstr "Wyślij mi kod"

#: bridge_oidc/templates/bridge_oidc/email_code_request.html:73
#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:70
msgid "Back to event sign in"
msgstr "Powrót do logowania do wydarzenia"

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:4
msgid "Enter Code"
msgstr "Wpisz kod"

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:11
msgid "Enter Your Code"
msgstr "Wpisz swój kod"

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:13
#, python-format
msgid ""
"We sent an 8-character code to %(email)s. It expires shortly, so enter it "
"soon."
msgstr "Wysłaliśmy 8-znakowy kod na adres %(email)s. Wygasa on wkrótce, więc wpisz go szybko."

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:39
msgid "8-character code"
msgstr "8-znakowy kod"

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:56
msgid "Verify and Sign In"
msgstr "Zweryfikuj i zaloguj się"

#: bridge_oidc/templates/bridge_oidc/email_code_verify.html:66
msgid "Use a different email"
msgstr "Użyj innego adresu e-mail"

#: bridge_oidc/templates/bridge_oidc/login.html:4
#: bridge_oidc/templates/bridge_oidc/login.html:159
msgid "Sign In"
msgstr "Zaloguj się"

#: bridge_oidc/templates/bridge_oidc/login.html:16
msgid "FOXCONS LOGIN HUB"
msgstr "FOXCONS LOGIN HUB"

#: bridge_oidc/templates/bridge_oidc/login.html:19
msgid ""
"Sign in to continue with your event account and pass the current Foxcons "
"identity into authentik."
msgstr "Zaloguj się do wydarzenia, aby przekazać swoje dane dalej."

#: bridge_oidc/templates/bridge_oidc/login.html:27
msgid "Select your event"
msgstr "Wybierz wydarzenie"

#: bridge_oidc/templates/bridge_oidc/login.html:28
msgid "Choose a Foxcons instance"
msgstr "Wybierz wydarzenie"

#: bridge_oidc/templates/bridge_oidc/login.html:30
msgid ""
"Pick the event you want to authenticate against. The selected Foxcons "
"instance defines where credentials are checked and which live claims are "
"forwarded."
msgstr "Wybierz wydarzenie, w którym chcesz się uwierzytelnić."

#: bridge_oidc/templates/bridge_oidc/login.html:68
msgid "Convention instance"
msgstr "Instancja konwentu"

#: bridge_oidc/templates/bridge_oidc/login.html:73
msgid "No events are currently available."
msgstr "Obecnie nie ma dostępnych wydarzeń."

#: bridge_oidc/templates/bridge_oidc/login.html:84
msgid "Can't access your event? Sign in with an email code"
msgstr "Nie masz dostępu do wydarzenia? Zaloguj się kodem e-mail"

#: bridge_oidc/templates/bridge_oidc/login.html:92
msgid "Sign in to"
msgstr "Zaloguj się do"

#: bridge_oidc/templates/bridge_oidc/login.html:136
msgid "Password"
msgstr "Hasło"

#: bridge_oidc/templates/bridge_oidc/login.html:147
msgid "••••••••"
msgstr "••••••••"

#: bridge_oidc/views.py:136
msgid "Too many login attempts. Please wait a few minutes and try again."
msgstr "Zbyt wiele prób logowania. Poczekaj kilka minut i spróbuj ponownie."

#: bridge_oidc/views.py:161
msgid "Invalid credentials or instance unavailable"
msgstr "Nieprawidłowe dane logowania lub instancja jest niedostępna"

#: bridge_oidc/views.py:235
msgid "Your saved session could not be refreshed. Please sign in again."
msgstr "Nie udało się odświeżyć zapisanej sesji. Zaloguj się ponownie."

#: bridge_oidc/views.py:310
msgid "Too many code requests. Please wait a few minutes and try again."
msgstr "Zbyt wiele próśb o kod. Poczekaj kilka minut i spróbuj ponownie."

#: bridge_oidc/views.py:315
msgid "Enter a valid email address."
msgstr "Wpisz prawidłowy adres e-mail."

#: bridge_oidc/views.py:331
msgid "Your Foxcons sign-in code"
msgstr "Twój kod logowania Foxcons"

#: bridge_oidc/views.py:333
#, python-format
msgid ""
"Your sign-in code is: %(code)s\n"
"\n"
"This code expires in %(minutes)d minutes."
msgstr ""
"Twój kod logowania to: %(code)s\n"
"\n"
"Kod wygasa za %(minutes)d minut."

#: bridge_oidc/views.py:342
msgid "Could not send the code email. Please try again shortly."
msgstr "Nie udało się wysłać e-maila z kodem. Spróbuj ponownie za chwilę."

#: bridge_oidc/views.py:384
msgid "Too many attempts. Please request a new code."
msgstr "Zbyt wiele prób. Poproś o nowy kod."

#: bridge_oidc/views.py:411
msgid "Invalid or expired code."
msgstr "Nieprawidłowy lub wygasły kod."
