# Django core
# Generate with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=replace-with-a-long-random-secret
DEBUG=False

# Comma-separated hostnames (no scheme)
ALLOWED_HOSTS=testauth.example.com

# Comma-separated full origins (with scheme)
CSRF_TRUSTED_ORIGINS=https://testauth.example.com

# SQLite location (absolute or project-relative path)
DATABASE_PATH=/app/data/db.sqlite3

# Session/CSRF cookie hardening for HTTPS deployments
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SESSION_COOKIE_HTTPONLY=True
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# OIDC signing key (PEM private key, single line with literal \n characters)
# Example:
# OIDC_RSA_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nMIIEv...\n-----END PRIVATE KEY-----
OIDC_RSA_PRIVATE_KEY=

# OAuth token lifetimes (seconds)
ACCESS_TOKEN_EXPIRE_SECONDS=3600
REFRESH_TOKEN_EXPIRE_SECONDS=604800

# Optional reverse-proxy SSL header support
SECURE_PROXY_SSL_HEADER=HTTP_X_FORWARDED_PROTO,https

# Optional: force HTTPS redirects at Django level
# SECURE_SSL_REDIRECT=True

# Gunicorn runtime
GUNICORN_WORKERS=3
GUNICORN_TIMEOUT=60

# Internal nginx port exposed on the host for Nginx Proxy Manager to target
NGINX_HOST_PORT=8080

# Login brute-force protection
BRIDGE_LOGIN_RATE_LIMIT_ATTEMPTS=10
BRIDGE_LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
